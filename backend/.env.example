# 数据库（backend/.env）—— 真实 .env 不入库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_traffic
DB_USER=root
DB_PASSWORD=            # 必填，提示用户填写，勿提交真实值

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# JWT
JWT_SECRET=             # 必填，随机 32 位以上字符串
JWT_EXPIRE_MINUTES=120

# 业务开关与 TTL
MOCK_DATA_ENABLED=true
CAPTCHA_TTL_SECONDS=300
DASHBOARD_CACHE_TTL_SECONDS=8
UPLOAD_DIR=uploads
